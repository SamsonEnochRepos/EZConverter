# EZConverter backend configuration. Copy to .env (never commit it). All values are optional unless marked REQUIRED.

# --- runtime identity --------------------------------------------------------
EZ_LOCATION=local                 # local = runs on the user's own device; remote = a server. A remote runtime refuses LOCAL_ONLY/AUTO uploads.
EZ_DATA_DIR=./data                # uploads, results, SQLite database. Must be private to the service user.

# --- authentication ----------------------------------------------------------
EZ_AUTH_MODE=token                # token | none ("none" only for a loopback-only single-user sidecar)
EZ_API_KEYS=                      # REQUIRED in token mode: "token1:userA,token2:userB". Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
EZ_ALLOWED_ORIGINS=               # comma-separated browser origins allowed by CORS, e.g. https://app.example.com

# --- limits ------------------------------------------------------------------
EZ_MAX_UPLOAD_MB=1024
EZ_MAX_BATCH_FILES=100
EZ_MAX_CONCURRENCY=2              # parallel conversion jobs (also bounded by a memory budget: EZ_MEMORY_BUDGET_MB, default 75% of RAM)
EZ_JOB_TIMEOUT_S=900
EZ_WORKER_MEMORY_MB=6144          # per-worker address-space limit (RLIMIT_AS)
EZ_WORKER_CPU_S=900
EZ_WORKER_OUTPUT_MB=4096          # largest single file a worker may write
EZ_ENGINE_THREADS=2
EZ_USER_QUOTA_MB=4096             # uploads + results per user
EZ_RATE_LIMIT_PER_MIN=600         # mutating requests per user per minute
EZ_MAX_ATTEMPTS=3                 # bounded automatic + manual attempts per job

# --- retention ---------------------------------------------------------------
EZ_RETENTION_HOURS=24             # uploads, results and job records are deleted after this
EZ_SWEEP_INTERVAL_S=60

# --- sandbox -----------------------------------------------------------------
EZ_NETWORK_ISOLATION=auto         # require (fail startup if unavailable) | auto (warn) | off. Check /v1/health -> network_isolation.

# --- capability advertising --------------------------------------------------
EZ_ADVERTISE=verified             # verified = only conformance-tested capabilities | all
# EZ_CONFORMANCE_MANIFEST=/path/to/verified_capabilities.json
# EZ_EXTRA_ENGINES=pkg.module:Class # operator-trusted plugin engines (code you chose to run)
