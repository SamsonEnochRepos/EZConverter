{
  "name": "@ezconverter/desktop",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "EZConverter desktop shell (Electron) around the shared web UI and a local Python converter sidecar.",
  "author": "SamsonEnochRepos",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "start": "pnpm --filter @ezconverter/web build && pnpm build && electron .",
    "test": "vitest run",
    "e2e": "pnpm --filter @ezconverter/web build && pnpm build && playwright test",
    "dist": "pnpm --filter @ezconverter/web build && pnpm build && electron-builder"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
